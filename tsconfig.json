{
  "compilerOptions": {
    
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["google.maps", "jasmine"],

    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,


    "verbatimModuleSyntax": true,
    "allowJs": false,


    "baseUrl": "src",
    "paths": {
    "@/*": ["*"],
    "@atoms/*": ["components/atoms/*"],
    "@molecules/*": ["components/molecules/*"],
    "@organisms/*": ["components/organisms/*"],
    "@templates/*": ["components/templates/*"],
    "@pages/*": ["components/pages/*"],
    "@domain/*": ["domain/*"],
    "@app": ["app/index.ts"],         
    "@app/*": ["app/*"],
    "@assets/*": ["assets/*"]               
}
  },


  "include": [
    "src",
    "vite-env.d.ts",
    "types/**/*.d.ts"
  ],


  "exclude": [
    "node_modules",
    "dist",
    "src/tests",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "run-tests.js"
  ]
}
